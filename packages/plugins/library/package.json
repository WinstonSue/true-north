{
  "name": "@true-north/plugin-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./src/manifest.ts",
      "import": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./main": {
      "types": "./src/main/index.ts",
      "import": "./src/main/index.ts",
      "default": "./src/main/index.ts"
    },
    "./renderer": {
      "types": "./src/renderer/index.tsx",
      "import": "./src/renderer/index.tsx",
      "default": "./src/renderer/index.tsx"
    }
  },
  "dependencies": {
    "@true-north/plugin-contract": "workspace:*",
    "@true-north/plugin-sdk": "workspace:*",
    "@true-north/enum": "workspace:*",
    "@true-north/vo": "workspace:*",
    "@sue/design-web-react": "0.0.3-beta.1",
    "lucide-react": "^0.460.0",
    "@ylib/product-surface-react": "0.0.2",
    "@ylib/product-server": "0.0.7",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.25.1",
    "typeorm": "^0.3.17"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/main/service/__tests__/*.test.ts"
  }
}
