{
  "name": "@true-north/web-service",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts",
      "default": "./index.ts"
    },
    "./electron-types": {
      "types": "./types/index.ts",
      "import": "./types/index.ts",
      "require": "./types/index.ts",
      "default": "./types/index.ts"
    },
    "./request": {
      "types": "./request/index.ts",
      "import": "./request/index.ts",
      "require": "./request/index.ts",
      "default": "./request/index.ts"
    }
  },
  "scripts": {
    "eslint": "eslint src/ --ext .ts,.tsx,.js,.jsx --fix --cache",
    "stylelint": "stylelint 'src/**/*.less' 'src/**/*.css' --fix --cache",
    "lint": "npm run eslint && npm run stylelint"
  },
  "dependencies": {
    "@sue/design-web-react": "file:../../../vendor/sue-design-web-react",
    "@true-north/vo": "workspace:*",
    "@true-north/enum": "workspace:*",
    "axios": "^0.24.0",
    "lodash-es": "^4.17.21"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache"
    ],
    "*.{css, less}": [
      "stylelint --fix"
    ]
  }
