{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": ["coverage/**"],
      "inputs": ["test/**/*.ts", "test/**/*.tsx", "**/__tests__/**/*.ts", "**/__tests__/**/*.tsx"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/desktop/**/*.{ts,tsx}", "packages/**/*.{ts,tsx}"]
    },
    "dev:product": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/desktop/**/*.{ts,tsx}", "packages/**/*.{ts,tsx}"]
    }
  }
}
