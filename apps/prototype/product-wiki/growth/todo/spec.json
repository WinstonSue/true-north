{
  "id": "growth.todo",
  "kind": "module",
  "title": "待办管理",
  "document": "growth/todo/README.md",
  "parentId": "growth",
  "route": "/growth/todo",
  "positioning": "承接手动事项和系统生成行动的最小执行颗粒，帮助用户安排今天要做的事。",
  "dependencies": [
    "growth.goal",
    "growth.task",
    "growth.habit"
  ],
  "entities": [
    {
      "id": "todo",
      "name": "待办",
      "fields": [
        {
          "id": "relatedType",
          "name": "创建来源",
          "type": "enum",
          "required": true,
          "values": [
            "task",
            "goal",
            "habit",
            "none"
          ],
          "description": "手动创建的待办固定为独立事项；仅系统生成待办可关联目标、任务或习惯，且只能有一个来源。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete",
          "changeLog": [
            {
              "version": "v0.1.0",
              "date": "2026-07-28",
              "event": "baseline",
              "summary": "建立字段基线。",
              "productStatus": "roadmap",
              "prototypeCoverage": "complete"
            }
          ]
        },
        {
          "id": "importance",
          "name": "重要性",
          "type": "number",
          "required": true,
          "description": "1 至 5，参与优先级矩阵。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete",
          "changeLog": [
            {
              "version": "v0.1.0",
