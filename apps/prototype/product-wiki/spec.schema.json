{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "true-north-prototype-product-wiki",
  "title": "ProductWiki module specification",
  "type": "object",
  "required": ["id", "kind", "title", "document", "productStatus", "prototypeCoverage", "changeLog", "references"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "kind": { "enum": ["global", "domain", "module"] },
    "title": { "type": "string", "minLength": 1 },
    "document": { "type": "string", "pattern": "^[a-z0-9_./-]+README\\.md$" },
    "parentId": { "type": "string" },
    "route": { "type": "string" },
    "positioning": { "type": "string" },
    "productStatus": { "$ref": "#/$defs/productStatus" },
    "prototypeCoverage": { "$ref": "#/$defs/prototypeCoverage" },
    "changeLog": { "$ref": "#/$defs/changeLog" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "entities": { "$ref": "#/$defs/entities" },
    "views": { "$ref": "#/$defs/views" },
    "rules": { "$ref": "#/$defs/rules" },
    "references": { "$ref": "#/$defs/references" }
  },
  "additionalProperties": false,
  "$defs": {
    "productStatus": { "enum": ["roadmap", "released", "deprecated"] },
    "prototypeCoverage": { "enum": ["none", "partial", "complete"] },
    "changeLog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date", "event", "summary", "productStatus", "prototypeCoverage"],
        "properties": {
          "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "event": { "enum": ["baseline", "introduced", "changed", "released", "deprecated"] },
          "summary": { "type": "string", "minLength": 1 },
          "productStatus": { "$ref": "#/$defs/productStatus" },
          "prototypeCoverage": { "$ref": "#/$defs/prototypeCoverage" }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "productStatus", "prototypeCoverage", "changeLog", "fields"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "productStatus": { "$ref": "#/$defs/productStatus" },
          "prototypeCoverage": { "$ref": "#/$defs/prototypeCoverage" },
          "changeLog": { "$ref": "#/$defs/changeLog" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "required", "description", "productStatus", "prototypeCoverage", "changeLog"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "values": { "type": "array", "items": { "type": "string" } },
                "description": { "type": "string" }
                ,"productStatus": { "$ref": "#/$defs/productStatus" }
                ,"prototypeCoverage": { "$ref": "#/$defs/prototypeCoverage" }
                ,"changeLog": { "$ref": "#/$defs/changeLog" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "prototypePage", "scenario", "productStatus", "prototypeCoverage", "reference", "changeLog"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "prototypePage": { "type": "string" },
          "scenario": { "type": "string" },
          "productStatus": { "$ref": "#/$defs/productStatus" },
          "prototypeCoverage": { "$ref": "#/$defs/prototypeCoverage" },
          "reference": { "type": "string" }
          ,"changeLog": { "$ref": "#/$defs/changeLog" }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "entities", "description", "reference", "productStatus", "prototypeCoverage", "changeLog"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "entities": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "views": { "type": "array", "items": { "type": "string" } },
          "reference": { "type": "string" }
          ,"productStatus": { "$ref": "#/$defs/productStatus" }
          ,"prototypeCoverage": { "$ref": "#/$defs/prototypeCoverage" }
          ,"changeLog": { "$ref": "#/$defs/changeLog" }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "heading"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "heading": { "type": "string", "minLength": 2 }
        },
        "additionalProperties": false
      }
    }
  }
}
